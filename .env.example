# PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/secret_santa?schema=public"

# Public base URL (used for magic links and Stripe redirects)
NEXTAUTH_URL=http://localhost:3000

# Secrets (min 32 chars each). SESSION_SECRET falls back to MAGIC_LINK_SECRET.
MAGIC_LINK_SECRET=change-me-to-a-random-string-of-at-least-32-chars
SESSION_SECRET=change-me-to-another-random-string-of-32-chars
MAGIC_LINK_EXPIRES_MINUTES=15

# Email (SMTP) for magic-link login. Leave unset to disable email login.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Secret Santa <noreply@example.com>"

# Stripe (Unlimited upgrade, one-time $10). A restricted key with
# "Checkout Sessions: write" is enough. Without STRIPE_SECRET_KEY the upgrade
# button reports payments unavailable.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_UNLIMITED=

# Legal page details (defaults shown)
LEGAL_OPERATOR="Flippingeasy LLC, trading as Realtap"
LEGAL_CONTACT_EMAIL=support@realtap.app
LEGAL_JURISDICTION="the Republic of South Africa"

# Cloudflare Web Analytics site token (public). Leave empty to disable the beacon.
NEXT_PUBLIC_CF_BEACON_TOKEN=444a18cd2e0b45b890e66c8a54d5aa2d
